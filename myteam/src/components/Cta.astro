---
import Button from './Button.astro';
---

<section class="relative bg-rose py-20 md:py-16 lg:py-19">
  <img
    src="/images/bg-pattern-home-6-about-5.svg"
    alt=""
    class="absolute bottom-0 left-0 w-25 lg:w-auto"
  />
  <div class="wrap relative flex flex-col items-center gap-6 md:flex-row md:justify-center md:gap-10 lg:max-w-[915px] lg:justify-between">
    <h2 class="heading-s text-center text-teal-900 lg:text-5xl">Ready to get started?</h2>
    <Button href="/contact" variant="dark">
      contact us
    </Button>
  </div>
</section>
