---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  page: string;
  file: string;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { page, file, alt, class: className, loading = 'lazy' } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/*/*/*.jpg', { eager: true });
const [desktop, tablet, mobile] = await Promise.all(
  ['desktop', 'tablet', 'mobile'].map((size) => {
    const image = images[`../assets/${page}/${size}/${file}`];
    if (!image) throw new Error(`Missing image: ${page}/${size}/${file}`);
    return getImage({ src: image.default, format: 'webp' });
  })
);
---

<picture>
  <source media="(min-width: 64rem)" srcset={desktop.src} />
  <source media="(min-width: 48rem)" srcset={tablet.src} />
  <img
    src={mobile.src}
    width={mobile.attributes.width}
    height={mobile.attributes.height}
    alt={alt}
    class={className}
    loading={loading}
    decoding="async"
  />
</picture>
