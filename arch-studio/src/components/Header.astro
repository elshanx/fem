---
import Logo from '../icons/logo.svg';
import Hamburger from '../icons/hamburger.svg';
import Close from '../icons/close.svg';

const links = [
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/about', label: 'About Us' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
---

<header
  class="wrap group relative z-20 flex h-24 items-center justify-between md:h-38 md:items-start md:justify-start md:gap-24 md:pt-14"
  data-header
>
  <a href="/" aria-label="Arch Studio home" class="text-dark">
    <Logo class="h-8 w-auto md:h-10" />
  </a>

  <button
    type="button"
    class="text-dark md:hidden"
    aria-expanded="false"
    aria-controls="site-nav"
    aria-label="Open menu"
    data-menu-toggle
  >
    <Hamburger class="group-data-open:hidden" aria-hidden="true" />
    <Close class="hidden group-data-open:block" aria-hidden="true" />
  </button>

  <div
    class="fixed inset-x-0 top-24 bottom-0 hidden bg-black/50 group-data-open:block md:hidden!"
    data-overlay
  ></div>

  <nav
    id="site-nav"
    aria-label="Main"
    class="absolute top-24 right-0 hidden w-[calc(100%-2rem)] bg-grey-lighter px-12 py-[42px] group-data-open:block md:static md:block! md:w-auto md:bg-transparent md:p-0 md:pt-1"
  >
    <ul class="flex flex-col gap-4 md:flex-row md:gap-14">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={path === href ? 'page' : undefined}
            class="heading-m md:text-label relative block text-dark transition-colors after:absolute after:right-0 after:-bottom-[7px] after:h-px after:w-6 after:bg-dark after:opacity-0 hover:text-grey md:text-grey md:hover:text-dark md:aria-[current=page]:text-dark md:aria-[current=page]:after:opacity-100"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;

  const setOpen = (open: boolean) => {
    header.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
  header.querySelector('[data-overlay]')!.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
