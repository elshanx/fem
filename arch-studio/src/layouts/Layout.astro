---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  label: string;
}

const { title, label } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title === 'Home' ? 'Arch Studio' : `${title} | Arch Studio`}</title>
  </head>
  <body>
    <div class="relative mx-auto max-w-[1440px] overflow-x-clip">
      <div
        aria-hidden="true"
        class="absolute top-0 left-[37px] hidden w-6 flex-col items-center gap-12 md:flex lg:left-[71px]"
      >
        <span class="h-26 w-px bg-grey-light"></span>
        <span class="tracking-[18px] text-grey-light uppercase [writing-mode:vertical-rl]">
          {label}
        </span>
      </div>
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
