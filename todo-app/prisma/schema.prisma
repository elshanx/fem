generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  completed Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now())

  @@index([ownerId, position])
}
